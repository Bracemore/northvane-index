---
// Tabbed line chart card ("Paid projects / Portfolio projects" pattern)
import { phasedTabs } from '../data';
const W = 1320, H = 420;
const padL = 56, padR = 24, padT = 24, padB = 44;
const innerW = W - padL - padR, innerH = H - padT - padB;
const yMax = 50;
function build(values: number[]) {
  const n = values.length;
  const x = (i: number) => padL + (i / (n - 1)) * innerW;
  const y = (v: number) => padT + innerH - (v / yMax) * innerH;
  const pts = values.map((v, i) => [x(i), y(v)]);
  let d = `M${pts[0][0]},${pts[0][1]}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] || pts[i], p1 = pts[i], p2 = pts[i + 1], p3 = pts[i + 2] || p2;
    d += ` C${p1[0] + (p2[0] - p0[0]) / 6},${p1[1] + (p2[1] - p0[1]) / 6} ${p2[0] - (p3[0] - p1[0]) / 6},${p2[1] - (p3[1] - p1[1]) / 6} ${p2[0]},${p2[1]}`;
  }
  return { d, pts, x, y };
}
const tabs = phasedTabs.map((t) => ({ ...t, ...build(t.values) }));
const yTicks = [0, 10, 20, 30, 40, 50];
---
<div class="tabs-card" data-tabs>
  <div class="tabs" role="tablist" aria-label="Site type">
    {tabs.map((t, i) => (
      <button class:list={['tab', { 'is-active': i === 0 }]} role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`panel-${t.key}`} id={`tab-${t.key}`} data-tab={t.key} type="button">
        {t.label}
      </button>
    ))}
  </div>
  {tabs.map((t, i) => (
    <section class:list={['panel', { 'is-active': i === 0 }]} role="tabpanel" id={`panel-${t.key}`} aria-labelledby={`tab-${t.key}`} data-panel={t.key} hidden={i !== 0}>
      <div class="panel__head">
        <h3 class="display--s" style="margin:0">{t.title}</h3>
        <div class="tools">
          <button class="tool tool--round" type="button" aria-label="How to read this chart" title={t.unit}>?</button>
          <a class="tool" href="/media/crane.jpg" download>Download image</a>
        </div>
      </div>
      <p class="mono unit">{t.unit}</p>
      <svg viewBox={`0 0 ${W} ${H}`} class="line-svg" role="img" aria-label={`${t.title}, ${t.label}`}>
        <g class="grid">
          {yTicks.map((v) => (
            <g>
              <line x1={padL} x2={W - padR} y1={t.y(v)} y2={t.y(v)} />
              <text x={padL - 10} y={t.y(v) + 4} text-anchor="end">{v}%</text>
            </g>
          ))}
          {t.months.map((m, j) => (
            <text x={t.x(j)} y={H - 14} text-anchor="middle">{m}</text>
          ))}
        </g>
        <path class="line" d={t.d} fill="none" stroke="var(--accent)" stroke-width="3" stroke-linecap="round" pathLength="1" />
        {t.pts.map(([px, py], j) => (
          <circle class="dot" cx={px} cy={py} r="4" fill="var(--paper)" stroke="var(--accent)" stroke-width="2" style={`--i:${j}`} />
        ))}
      </svg>
    </section>
  ))}
</div>

<style>
  .tabs-card { background: var(--paper); border-radius: 8px; box-shadow: 0 1px 0 rgba(0,0,0,0.06), 0 30px 60px -40px rgba(0,0,0,0.25); overflow: hidden; }
  .tabs { display: grid; grid-template-columns: 1fr 1fr; background: var(--sand-2); }
  .tab { padding: 16px; font-size: 14px; font-weight: 500; color: var(--ink-2); background: #d9ece9; transition: background 0.3s ease, color 0.3s ease; }
  .tab.is-active { background: var(--paper); color: var(--ink); }
  .panel { padding: clamp(20px, 3vw, 40px); }
  .panel__head { display: flex; justify-content: space-between; gap: 16px; align-items: center; flex-wrap: wrap; }
  .tools { display: flex; gap: 8px; }
  .tool { height: 36px; padding: 0 16px; border-radius: 999px; background: var(--ink); color: var(--paper); font-size: 13px; font-weight: 500; display: inline-flex; align-items: center; }
  .tool--round { width: 36px; padding: 0; justify-content: center; background: transparent; color: var(--ink); box-shadow: inset 0 0 0 1px var(--ink-3); }
  .unit { color: var(--ink-3); margin: 8px 0 24px; }
  .line-svg { width: 100%; height: auto; }
  .grid line { stroke: rgba(20,20,20,0.12); }
  .grid text { font-family: var(--font-mono); font-size: 11px; fill: var(--ink-3); }
  .line { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .dot { opacity: 0; transition: opacity 0.3s ease calc(var(--i) * 0.05s); }
  .panel.is-drawn .line { animation: draw 1.6s cubic-bezier(0.65, 0, 0.25, 1) forwards; }
  .panel.is-drawn .dot { opacity: 1; transition-delay: calc(0.4s + var(--i) * 0.06s); }
  @keyframes draw { to { stroke-dashoffset: 0; } }
</style>
