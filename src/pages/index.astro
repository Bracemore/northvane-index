---
import Base from '../layouts/Base.astro';
import AreaChart from '../components/AreaChart.astro';
import TabsChart from '../components/TabsChart.astro';
import { brand, chapters, nav, orbCards, methodology } from '../data';
---
<Base>
  <!-- Fixed scene layers: scrolling fades between them -->
  <div class="scene" data-scene="hero" style="opacity:1">
    <video src="/media/hero.mp4" poster="/media/hero.jpg" autoplay muted loop playsinline></video>
  </div>
  <div class="scene" data-scene="night">
    <video src="/media/night.mp4" poster="/media/night.jpg" muted loop playsinline preload="none"></video>
    <canvas class="stars" aria-hidden="true"></canvas>
  </div>
  <div class="scene" data-scene="dawn">
    <video src="/media/dawn.mp4" poster="/media/dawn.jpg" muted loop playsinline preload="none"></video>
  </div>
  <div class="scene" data-scene="day">
    <video src="/media/day.mp4" poster="/media/day.jpg" muted loop playsinline preload="none"></video>
  </div>
  <div class="scene scene--paper" data-scene="paper"></div>

  <!-- Top nav -->
  <header class="topnav" data-topnav>
    <a class="topnav__brand" href="#overview" aria-label={`${brand.name} home`}>
      <svg width="22" height="22" viewBox="0 0 32 32" aria-hidden="true"><path d="M8 24V8l16 16V8" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"/></svg>
      <span>{brand.name}</span>
    </a>
    <nav class="topnav__links" aria-label="Site">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
    <div class="topnav__cta">
      <a class="btn btn--light" href="#method">Get the Index</a>
    </div>
  </header>

  <!-- Chapter dots (left rail) -->
  <nav class="rail" aria-label="Chapters" data-rail>
    <ul>
      {chapters.map((c, i) => (
        <li><a href={`#${c.id}`} data-chapter={c.id} class:list={{ 'is-active': i === 0 }}><i></i><span>{c.label}</span></a></li>
      ))}
    </ul>
  </nav>

  <main id="main">
    <!-- 1. HERO -->
    <section class="section hero" id="overview" data-chapter-start="overview">
      <div class="hero__inner wrap">
        <h1 class="display display--xl hero__title" data-split>
          <span>Inference</span><span>Buildout</span><span>2026</span>
        </h1>
      </div>
    </section>

    <!-- 2. NIGHT: statement -->
    <section class="section statement" data-pin="statement">
      <div class="statement__inner wrap">
        <h2 class="display display--l statement__title" data-reveal>The largest field dataset on modular AI capacity</h2>
        <p class="lede statement__lede" data-reveal>
          We tracked 212 live sites and 1.9 GW of contracted capacity across 14 countries for twelve months, and paired every reading with the contracts behind it. Speed, power, cooling, revenue timing, and where the next gigawatt lands.
        </p>
      </div>
    </section>

    <!-- 3. ORB: network of sites -->
    <section class="section orb-scene" data-pin="orb">
      <div class="orb-scene__sticky">
        <div class="orb-scene__copy wrap">
          <h2 class="display display--m">Built from a network<br />of 212 live sites</h2>
          <p class="orb-scene__text">
            Northvane builds and operates factory-made AI data centers under one contract. Every unit reports power, thermal and utilisation telemetry back to the same platform, which is where this Index comes from.
          </p>
          <a class="btn btn--light" href="#method">More about Northvane</a>
        </div>
        <div class="orb" data-orb aria-hidden="true">
          <div class="orb__core"></div>
          <div class="orb__cards">
            {orbCards.map((c, i) => (
              <figure class="orb__card" style={`--i:${i}`}>
                <img src={c.src} alt="" width="120" height="120" loading="lazy" decoding="async" />
              </figure>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 4. DAWN: chapter title -->
    <section class="section chapter" id="deployment" data-chapter-start="deployment" data-pin="chapter-1">
      <div class="chapter__inner wrap">
        <h2 class="display display--xl chapter__title" data-split><span>Deployment</span></h2>
        <p class="chapter__kicker mono">Across the AI buildout</p>
      </div>
    </section>

    <!-- 5. DAY: thesis + area chart growing out of the clouds -->
    <section class="section thesis">
      <div class="wrap thesis__inner">
        <h2 class="display display--m" data-reveal>Operators are bringing capacity online faster than ever.</h2>
        <p class="lede" data-reveal>From a single 4.5 MW unit on a brownfield pad to networked 100 MW+ campuses, the share of contracted capacity that is actually energized has moved past pilots into routine delivery.</p>
      </div>
    </section>

    <section class="section chart-scene" data-chart-scene>
      <div class="wrap">
        <AreaChart />
      </div>
    </section>

    <section class="section paper-block">
      <div class="wrap">
        <TabsChart />
      </div>
    </section>

    <!-- CTA + method / footer (closes stage 1) -->
    <section class="section cta" id="method">
      <div class="wrap cta__inner">
        <h2 class="display display--l">Get the full<br />Inference Buildout Index 2026</h2>
        <p class="lede">Twelve months of field readings, 212 sites, every chart with its method. Delivered as a 48-page PDF and a quarterly data drop.</p>
        <a class="btn btn--light" href="mailto:index@northvane.example">Get the Index</a>
        <dl class="method">
          {methodology.map(([v, l]) => (
            <div><dt class="display--s">{v}</dt><dd class="mono">{l}</dd></div>
          ))}
        </dl>
      </div>
    </section>

    <footer class="section footer">
      <div class="wrap footer__inner">
        <div>
          <p class="footer__brand">{brand.name}</p>
          <p class="footer__tag">Factory-built AI infrastructure,<br />delivered under one contract.</p>
        </div>
        <nav class="footer__links" aria-label="Footer">
          {chapters.map((c) => <a href={`#${c.id}`}>{c.label}</a>)}
        </nav>
        <p class="mono footer__copy">© 2026 Northvane. Index data: Northvane platform telemetry, Oct 2025 – Sep 2026.</p>
      </div>
    </footer>
  </main>

  <script>
    import { init } from '../scripts/main';
    init();
  </script>
</Base>

<style>
  /* ---------- fixed chrome ---------- */
  .topnav {
    position: fixed; inset: 0 0 auto 0; z-index: 50; height: var(--nav-h);
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    padding: 0 clamp(16px, 3vw, 40px); color: var(--paper);
    transform: translateY(-100%); transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), color 0.4s ease, background 0.4s ease;
  }
  .topnav.is-visible { transform: none; }
  .topnav.is-dark { color: var(--ink); background: rgba(250, 249, 246, 0.82); backdrop-filter: blur(12px); }
  .topnav.is-dark .btn--light { background: var(--ink); color: var(--paper); }
  .topnav__brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; letter-spacing: -0.01em; }
  .topnav__links { display: flex; gap: 28px; font-size: 14px; font-weight: 500; }
  .topnav__links a { opacity: 0.85; } .topnav__links a:hover { opacity: 1; }
  .topnav__cta { justify-self: end; }

  .rail { position: fixed; left: clamp(10px, 1.6vw, 24px); top: 50%; transform: translateY(-50%); z-index: 40; opacity: 0; transition: opacity 0.6s ease; }
  .rail.is-visible { opacity: 1; }
  .rail ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .rail a { display: flex; align-items: center; gap: 10px; color: var(--rail-ink, var(--paper)); }
  .rail i { width: 6px; height: 6px; border-radius: 50%; background: currentColor; opacity: 0.5; transition: transform 0.3s ease, opacity 0.3s ease; }
  .rail a.is-active i { opacity: 1; transform: scale(1.8) rotate(45deg); border-radius: 1px; }
  .rail span { font-family: var(--font-mono); font-size: 11px; opacity: 0; transform: translateX(-6px); transition: opacity 0.3s ease, transform 0.3s ease; }
  .rail a:hover span, .rail a.is-active span { opacity: 0.9; transform: none; }
  .rail.is-dark { --rail-ink: var(--ink); }

  /* ---------- scenes ---------- */
  .scene--paper { background: var(--sand); }
  .stars { position: absolute; inset: 0; width: 100%; height: 100%; }

  /* ---------- hero ---------- */
  .hero { height: 100vh; display: flex; align-items: center; color: var(--paper); }
  .hero__inner { width: 100%; }
  .hero__title { display: grid; }
  .hero__title span { display: block; overflow: hidden; }

  /* ---------- statement (night) ---------- */
  .statement { min-height: 140vh; display: flex; align-items: center; color: var(--paper); text-align: center; }
  .statement__inner { display: grid; justify-items: center; gap: 24px; }
  .statement__title { max-width: 16ch; }
  .statement__lede { color: rgba(250, 249, 246, 0.82); max-width: 58ch; }

  /* ---------- orb ---------- */
  .orb-scene { height: 260vh; color: var(--paper); }
  .orb-scene__sticky { position: sticky; top: 0; height: 100vh; overflow: hidden; display: grid; align-items: center; }
  .orb-scene__copy { position: relative; z-index: 3; max-width: 380px; display: grid; gap: 18px; }
  .orb-scene__text { margin: 0; font-size: 14px; line-height: 1.5; color: rgba(250, 249, 246, 0.85); }
  .orb { position: absolute; left: 50%; top: 50%; width: 420px; height: 420px; transform: translate(-50%, -50%) scale(0.18); perspective: 1200px; }
  .orb__core { position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #f2e9df 0%, #d9c7b4 35%, #a7b6c2 70%, #6f7f8f 100%); box-shadow: 0 0 120px rgba(255, 230, 200, 0.35); }
  .orb__cards { position: absolute; inset: 0; transform-style: preserve-3d; }
  .orb__card {
    --phi: calc(acos(1 - 2 * (var(--i) + 0.5) / 30));
    --theta: calc(var(--i) * 137.508deg);
    position: absolute; left: 50%; top: 50%; width: 64px; height: 64px; margin: -32px 0 0 -32px;
    transform: rotateY(var(--theta)) rotateX(calc(90deg - var(--phi))) translateZ(232px);
    backface-visibility: hidden; background: #fff; padding: 3px; box-shadow: 0 6px 18px rgba(0,0,0,0.25);
  }
  .orb__card img { width: 100%; height: 100%; object-fit: cover; }

  /* ---------- chapter title ---------- */
  .chapter { height: 160vh; color: var(--ink); }
  .chapter__inner { position: sticky; top: 0; height: 100vh; display: flex; flex-direction: column; justify-content: flex-end; padding-bottom: 14vh; }
  .chapter__title span { display: block; overflow: hidden; }
  .chapter__kicker { margin: 10px 0 0; color: var(--ink-2); text-transform: uppercase; letter-spacing: 0.08em; }

  /* ---------- thesis + chart ---------- */
  .thesis { min-height: 90vh; display: grid; align-items: center; text-align: center; }
  .thesis__inner { display: grid; justify-items: center; gap: 20px; }
  .thesis__inner .display--m { max-width: 22ch; }
  .chart-scene { padding: 10vh 0 18vh; }
  .paper-block { padding: 0 0 14vh; }

  /* ---------- cta / footer ---------- */
  .cta { padding: 18vh 0; background: var(--night); color: var(--paper); position: relative; overflow: hidden; }
  .cta::before { content: ''; position: absolute; inset: 0; background: url('/media/golden.jpg') center/cover; opacity: 0.35; }
  .cta__inner { position: relative; display: grid; gap: 24px; justify-items: start; }
  .cta .lede { color: rgba(250, 249, 246, 0.8); }
  .method { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 24px; margin: 40px 0 0; width: 100%; }
  .method dt { margin: 0; } .method dd { margin: 6px 0 0; color: rgba(250, 249, 246, 0.7); }
  .footer { background: var(--night); color: var(--paper); padding: 48px 0; border-top: 1px solid rgba(255,255,255,0.1); }
  .footer__inner { display: grid; grid-template-columns: 1fr auto; gap: 32px; align-items: start; }
  .footer__brand { margin: 0; font-weight: 600; } .footer__tag { margin: 8px 0 0; color: rgba(250,249,246,0.7); font-size: 14px; }
  .footer__links { display: flex; flex-wrap: wrap; gap: 20px; font-size: 14px; }
  .footer__copy { grid-column: 1 / -1; color: rgba(250,249,246,0.5); margin: 24px 0 0; }

  @media (max-width: 820px) {
    .topnav { grid-template-columns: 1fr auto; }
    .topnav__links { display: none; }
    .rail { display: none; }
    .orb { width: 300px; height: 300px; }
    .orb__card { transform: rotateY(var(--theta)) rotateX(calc(90deg - var(--phi))) translateZ(165px); width: 48px; height: 48px; margin: -24px 0 0 -24px; }
    .footer__inner { grid-template-columns: 1fr; }
  }
</style>
